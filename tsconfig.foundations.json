{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "moduleDetection": "force"
  },
  "include": [
    "src/foundations/**/*.ts",
    "src/foundations/**/*.mts",
    "src/foundations/wasm-guest-runtime.mjs",
    "src/foundations/wasm-worker.mjs",
    "src/foundations/wasm-worker-browser.mjs",
    "src/modules/**/*.ts",
    "scripts/verify-wasm.ts",
    "scripts/build-wasm-module.ts",
    "scripts/check-wasm-module.ts",
    "scripts/browser-wasm.ts",
    "scripts/browser-compose-entry.ts"
  ]
}
